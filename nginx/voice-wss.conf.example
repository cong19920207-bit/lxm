# M2 deployment candidate, NOT included by nginx.conf and NOT deployed.
# Substitute the real origin/domain and certificate paths at deployment.
# 同域部署无需 VOICE_ALLOWED_ORIGINS；显式配置时仍以其为准。
# Backend must trust proxy headers ONLY from this gateway's private address;
# do not expose its listening port directly to public traffic.
# This example supports hard_limit <= 3600s, grace <= 30s, reconnect <= 60s.
# Recalculate timeouts before selecting larger business limits.
worker_processes auto;
error_log /var/log/nginx/voice-error.log crit;
events { worker_connections 2048; }
http {
    map $http_upgrade $voice_upgrade {
        default close;
        ~*^websocket$ upgrade;
    }
    limit_conn_zone $binary_remote_addr zone=voice_clients:10m;
    # No query strings, Authorization, subprotocol tickets or body in logs.
    log_format voice_meta '$remote_addr $status $request_time';
    access_log /var/log/nginx/voice-access.log voice_meta;
    server {
        listen 443 ssl;
        server_name voice.example.invalid;
        ssl_certificate /etc/nginx/certs/voice-fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/voice-key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        location ~ "^/api/voice/calls/[0-9a-f-]{36}/(stream|reconnect-stream)$" {
            if ($args != "") { return 400; }
            limit_conn voice_clients 4;
            proxy_pass http://backend:8000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $voice_upgrade;
            proxy_set_header Host $http_host;
            proxy_set_header Origin $http_origin;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_connect_timeout 5s;
            proxy_read_timeout 3700s;
            proxy_send_timeout 3700s;
            send_timeout 3700s;
            proxy_buffering off;
            proxy_cache off;
        }
        location / { return 404; }
    }
}
